{
    "name": "@eccenca/gui-elements",
    "description": "eccenca design system: React components on Radix primitives and Tailwind CSS (shadcn/ui-style), written in TypeScript.",
    "version": "26.0.0",
    "license": "Apache-2.0",
    "homepage": "https://github.com/eccenca/gui-elements",
    "bugs": "https://github.com/eccenca/gui-elements/issues",
    "keywords": [
        "GUI",
        "React",
        "Radix",
        "Tailwind CSS",
        "shadcn/ui",
        "Typescript"
    ],
    "maintainers": [
        {
            "name": " eccenca GmbH",
            "email": "info@eccenca.com",
            "web": "https://eccence.com/"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/eccenca/gui-elements.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "engines": {
        "node": ">=18.18.0"
    },
    "style": "src/css/index.css",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./css/*": "./src/css/*"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "project:clean": "yarn test:clean && yarn build:clean && yarn storybook:clean && rimraf yarn-error.log",
        "build:clean": "rimraf dist/",
        "build:esm": "tsc --project .typescript/tsbuild-esm.json && tsc-alias -p .typescript/tsc-alias-esm.json && tsc-alias -p .typescript/tsc-alias-esm.json --outDir dist/types && ./scripts/fix-esm-dist",
        "build:cjs": "tsc --project .typescript/tsbuild-cjs.json && tsc-alias -p .typescript/tsc-alias-cjs.json && ./scripts/fix-cjs-dist",
        "build:all": "yarn build:clean && yarn build:esm && yarn build:cjs",
        "compile": "tsc --build tsconfig.json",
        "tailwind:build": "tailwindcss -i .storybook/tailwind.entry.css -o .storybook/tailwind.generated.css",
        "tailwind:watch": "tailwindcss -i .storybook/tailwind.entry.css -o .storybook/tailwind.generated.css --watch",
        "storybook": "yarn tailwind:build && concurrently -k \"yarn tailwind:watch\" \"storybook dev -p 6006 --no-open\"",
        "build-storybook": "yarn tailwind:build && storybook build --webpack-stats-json",
        "storybook:clean": "rimraf storybook-static/",
        "test": "jest",
        "test:ci": "jest --ci --reporters='default'",
        "test:coverage": "jest --collectCoverage",
        "test:clean": "rimraf .jest-test-results.json && rimraf coverage/",
        "autolint:scripts": "eslint --fix .storybook/ scripts/ src/ index.ts || exit 0",
        "autolint:styles": "stylelint \"{.storybook,src}/**/*.css\" --fix || exit 0",
        "autolint:prettier": "prettier \"{.github,.storybook,.typescript,scripts,src}/**/*\" .* *.json *.md *.ts --write --ignore-unknown",
        "autolint:all": "yarn autolint:scripts && yarn autolint:styles && yarn autolint:prettier"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/legacy-modes": "^6.5.2",
        "@mavrin/remark-typograf": "^2.2.0",
        "@popperjs/core": "^2.11.8",
        "@radix-ui/react-accordion": "^1.2.16",
        "@radix-ui/react-alert-dialog": "^1.1.19",
        "@radix-ui/react-checkbox": "^1.3.7",
        "@radix-ui/react-collapsible": "^1.1.16",
        "@radix-ui/react-context-menu": "^2.3.3",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@radix-ui/react-hover-card": "^1.1.19",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-navigation-menu": "^1.2.18",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-progress": "^1.1.12",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-separator": "^1.1.11",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.17",
        "@radix-ui/react-toggle": "^1.1.14",
        "@radix-ui/react-toggle-group": "^1.1.15",
        "@radix-ui/react-tooltip": "^1.2.12",
        "@radix-ui/react-use-controllable-state": "^1.2.3",
        "@shadcn/react": "^0.2.1",
        "@xyflow/react": "^12.9.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "codemirror": "^6.0.2",
        "color": "^5.0.3",
        "compute-scroll-into-view": "^3.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "he": "^1.2.0",
        "input-otp": "^1.4.2",
        "jshint": "^2.13.6",
        "lodash": "^4.18.1",
        "lucide-react": "^1.23.0",
        "n3": "^1.26.0",
        "nanoid": "^3.3.4",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.2",
        "re-resizable": "^6.10.3",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "react-flow-renderer": "9.7.4",
        "react-inlinesvg": "^4.4.1",
        "react-is": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.7.2",
        "react-syntax-highlighter": "^16.1.1",
        "recharts": "3.8.0",
        "rehype-external-links": "^3.0.0",
        "rehype-raw": "^7.0.0",
        "remark-definition-list": "^2.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "unified": "^11.0.5",
        "use-stick-to-bottom": "^1.1.3",
        "vaul": "^1.1.2",
        "wicg-inert": "^3.1.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.4.0",
        "@storybook/addon-docs": "^10.4.0",
        "@storybook/addon-links": "^10.4.0",
        "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
        "@storybook/cli": "^10.4.0",
        "@storybook/react": "^10.4.0",
        "@storybook/react-webpack5": "^10.4.0",
        "@swc/core": "^1.15.43",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/cli": "^4.3.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/he": "^1.2.3",
        "@types/jest": "^30.0.0",
        "@types/jshint": "^2.12.4",
        "@types/lodash": "^4.17.24",
        "@types/n3": "^1.26.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/react-is": "^19.2.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "chromatic": "^16.10.1",
        "concurrently": "^9.2.3",
        "eslint": "^10.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "husky": "^4.3.8",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-fixed-jsdom": "^0.0.11",
        "jest-pnp-resolver": "^1.2.3",
        "lint-staged": "^15.5.2",
        "path": "^0.12.7",
        "prettier": "^3.8.3",
        "react-lorem-ipsum": "^1.4.9",
        "rimraf": "^6.1.3",
        "storybook": "^10.4.0",
        "stylelint": "^17.11.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.1",
        "tailwindcss": "^4.3.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsc-esm-fix": "^3.1.2",
        "typescript": "^5.9.3",
        "url-loader": "^4.1.1",
        "yargs": "^18.0.0"
    },
    "peerDependencies": {
        "react": ">=19"
    },
    "resolutions": {
        "hast-util-from-parse5": "8.0.0",
        "**/lodash": "^4.18.1",
        "**/minimatch": "^3.1.4",
        "**/serialize-javascript": "^7.0.5"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.(json|md)": [
            "prettier --write",
            "git add"
        ],
        "*.(js|ts|tsx)": [
            "eslint --fix",
            "prettier --write",
            "git add"
        ],
        "*.(css)": [
            "stylelint --fix",
            "prettier --write",
            "git add"
        ]
    },
    "jest": {
        "roots": [
            "<rootDir>/src/"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts,tsx}",
            "!src/**/*.d.ts"
        ],
        "resolver": "jest-pnp-resolver",
        "setupFilesAfterEnv": [
            "<rootDir>/src/test/setupTests.js"
        ],
        "testMatch": [
            "<rootDir>/src/**/*(*.)@(spec|test).{js,jsx,ts,tsx}"
        ],
        "testEnvironment": "jest-fixed-jsdom",
        "transform": {
            "^.+\\.(ts|tsx)$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "typescript",
                            "tsx": true
                        },
                        "transform": {
                            "react": {
                                "runtime": "automatic"
                            }
                        },
                        "loose": true,
                        "target": "es2020"
                    }
                }
            ],
            "^.+\\.(js|jsx)$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "ecmascript",
                            "jsx": true
                        },
                        "transform": {
                            "react": {
                                "runtime": "automatic"
                            }
                        },
                        "loose": true,
                        "target": "es2020"
                    }
                }
            ]
        },
        "transformIgnorePatterns": [
            "[/\\\\]node_modules[/\\\\](?!react-markdown|vfile|unist-util-stringify-position|).+\\.(js|jsx|ts|tsx)$",
            "^.+\\.module\\.css$"
        ],
        "moduleFileExtensions": [
            "web.js",
            "js",
            "web.ts",
            "ts",
            "web.tsx",
            "tsx",
            "json",
            "web.jsx",
            "jsx",
            "node"
        ],
        "moduleNameMapper": {
            "\\.css$": "identity-obj-proxy",
            "\\.(png|jpe?g|gif|svg|ico|webp|avif)$": "<rootDir>/src/test/fileMock.js",
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    }
}
